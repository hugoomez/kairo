{
  "description": "Kairo vault hooks: send_guard, derived views (digest, ledger, Smart Connections index, SOTA staleness), Bitácora commit log, session capture. All routed by scripts/hooks/kairo_hook.py; a silent no-op outside a Kairo vault.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash|PowerShell|mcp__smart-connections__get_note",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/kairo_hook.py\" pre-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/kairo_hook.py\" post-write",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/kairo_hook.py\" post-shell",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/kairo_hook.py\" session-end",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
