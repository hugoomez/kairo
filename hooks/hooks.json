{
  "description": "Kairo vault hooks: send_guard, derived views (digest, ledger, Smart Connections index, SOTA staleness), Bitácora commit log, session capture, isolated agents' replies. All routed by scripts/hooks/kairo_hook.py, started by kairo_hook.sh (python, else python3; without either it says so and refuses reads inside a vault); a silent no-op outside a Kairo vault.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash|PowerShell|mcp__smart-connections__get_note",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/kairo_hook.sh\" pre-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/kairo_hook.sh\" post-write",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/kairo_hook.sh\" post-shell",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/kairo_hook.sh\" subagent-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/kairo_hook.sh\" session-end",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
